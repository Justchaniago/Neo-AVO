[Unit]
Description=Neo AVO worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=neo-avo
WorkingDirectory=/opt/neo-avo
EnvironmentFile=/etc/neo-avo/neo-avo.env
EnvironmentFile=-/etc/neo-avo/telegram.env
ExecStart=/usr/bin/npm run worker
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
